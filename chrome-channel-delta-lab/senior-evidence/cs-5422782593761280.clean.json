ors placing text along a path have no way to flip which side of the path the text appears on. The side attribute lets authors write side=\"right\" to place text on the opposite side of the path, without duplicating or reversing the path data. This helps label both the inside and outside of a shape, such as a circular path, with different text on each side.", "devtrial_instructions": null, "activation_risks": null, "measurement": null, "availability_expectation": null, "adoption_expectation": null, "adoption_plan": null, "initial_public_proposal_url": null, "explainer_links": [], "requires_embedder_support": false, "spec_link": "https://w3c.github.io/svgwg/svg2-draft/text.html#TextPathElementSideAttribute", "api_spec": true, "automation_spec": false, "interop_compat_risks": "Firefox already shipped this (Firefox 152): https://bugzilla.mozilla.org/show_bug.cgi?id=2034371\nWebKit has it in progress (not merged yet): https://github.com/WebKit/WebKit/pull/66616\nThe SVG Working Group resolved to add IDL constants for side (w3.org/2026/04/23-svg-minutes.html#2c4e)", "all_platforms": true, "all_platforms_descr": null, "non_oss_deps": null, "anticipated_spec_changes": "The SVG WG resolved to add IDL constants for side, but this hasn't yet been reflected in the published Editor's Draft text - an editorial gap, not an open design question (https://github.com/w3c/svgwg/issues/1086).", "security_risks": "No new security concerns. The attribute only changes where already-visible text is rendered along a path.", "ergonomics_risks": null, "wpt": true, "wpt_descr": "https://wpt.fyi/results/svg/types/scripted/SVGAnimatedEnumeration-SVGTextPathElement.html\nhttps://wpt.fyi/results/svg/text/reftests/textpath-side-003.svg\nhttps://wpt.fyi/results/svg/text/reftests/textpath-side-005.svg", "webview_risks": null, "devrel_emails": ["devrel-chromestatus-all@google.com"], "debuggability": "No special DevTools support needed. The side attribute is visible and editable like any other SVG attribute in the Elements panel.", "doc_links": [], "sample_links": [], "prefixed": null, "tags": [], "tag_review": "https://github.com/w3ctag/design-reviews/issues/1279", "tag_review_status": "Not applicable", "tag_review_status_int": 4, "security_review_status": "Pending", "security_review_status_int": 1, "privacy_review_status": "Pending", "privacy_review_status_int": 1, "security_continuity_id": null, "security_launch_issue_id": null, "updated_display": null, "resources": {"samples": [], "docs": []}, "comments": null, "ff_views": 1, "safari_views": 2, "web_dev_views": 4, "browsers": {"chrome": {"bug": "https://issues.chromium.org/issues/40362379", "blink_components": ["Blink>SVG"], "devrel": ["devrel-chromestatus-all@google.com"], "owners": ["hyowon@igalia.com"], "origintrial": false, "prefixed": null, "flag": false, "status": {"text": "Proposed", "val": 2, "milestone_str": "Proposed"}, "announced": false, "desktop": 158, "android": 158, "webview": 158, "ios": null}, "ff": {"view": {"url": "https://bugzilla.mozilla.org/show_bug.cgi?id=2034371", "notes": null, "text": "Shipped/Shipping", "val": 1}}, "safari": {"view": {"url": "https://github.com/WebKit/WebKit/pull/66616", "notes": null, "text": "In development", "val": 2}}, "webdev": {"view": {"text": "No signals", "val": 4, "url": null, "notes": null}}, "other": {"view": {"text": null, "val": null, "url": null, "notes": null}}}, "standards": {"spec": "https://w3c.github.io/svgwg/svg2-draft/text.html#TextPathElementSideAttribute", "maturity": {"text": "Specification currently under development in a Working Group", "short_text": "Working draft", "val": 4}}, "is_released": false, "is_enterprise_feature": false, "experiment_timeline": null, "ai_test_eval_report": null, "ai_test_eval_run_status": null, "ai_test_eval_status_timestamp": null}