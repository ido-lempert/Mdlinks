{"id": 6294595288825856, "name": "CSS text-overflow: <string> value", "summary": "Adds a <string> value to the text-overflow property.\n\nThis allows web authors to specify a custom string (e.g., \"(more)\") to indicate that text has been clipped. This provides more design flexibility and can be used to create more user-friendly and context-aware overflow indicators.", "markdown_fields": [], "blink_components": ["Blink>CSS"], "star_count": 16, "search_tags": ["text-overflow"], "created": {"by": "jja08111@gmail.com", "when": "2026-08-18 05:34:17.605213"}, "updated": {"by": "jja08111@gmail.com", "when": "2026-10-19 08:04:45.453117"}, "category": "CSS", "category_int": 15, "feature_notes": null, "web_feature": "custom-ellipses", "is_official_web_feature": true, "webdx_usecounter_enum": null, "enterprise_feature_categories": ["1"], "enterprise_product_category": 0, "is_releasenotes_content_reviewed": false, "is_releasenotes_publish_ready": false, "stages": [{"id": 5376915765592064, "created": "2026-08-18 05:34:18.687784", "feature_id": 6294595288825856, "stage_type": 110, "display_name": null, "pm_emails": [], "tl_emails": [], "ux_emails": [], "te_emails": [], "intent_thread_url": null, "announcement_url": null, "experiment_goals": null, "experiment_risks": null, "origin_trial_id": null, "origin_trial_feedback_url": null, "ot_action_requested": false, "ot_approval_buganizer_component": null, "ot_approval_buganizer_custom_field_id": null, "ot_approval_criteria_url": null, "ot_approval_group_email": null, "ot_chromium_trial_name": null, "ot_description": null, "ot_display_name": null, "ot_documentation_url": null, "ot_emails": [], "ot_feedback_submission_url": null, "ot_has_third_party_support": false, "ot_is_critical_trial": false, "ot_is_deprecation_trial": false, "ot_owner_email": null, "ot_requester_email": null, "ot_require_approvals": false, "ot_use_counter_bucket_number": null, "ot_webfeature_use_counter": null, "extensions": [], "experiment_extension_reason": null